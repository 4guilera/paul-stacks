# Managed by Ansible (paul-stacks). Manual edits will be overwritten.
cluster-init: true
node-ip: {{ ansible_host }}
tls-san:
  - {{ ansible_host }}
  - {{ inventory_hostname }}
write-kubeconfig-mode: "0600"
secrets-encryption: true
disable:
{% for item in k3s_disable %}
  - {{ item }}
{% endfor %}

# Control-plane metrics for kube-prometheus-stack.
# k3s binds these to localhost by default; Prometheus runs on another node.
etcd-expose-metrics: true
kube-controller-manager-arg:
  - bind-address=0.0.0.0
kube-scheduler-arg:
  - bind-address=0.0.0.0
kube-proxy-arg:
  - metrics-bind-address=0.0.0.0
